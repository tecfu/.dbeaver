set gvimpath=gvim

" Made possible by: https://github.com/vrapper/vrapper
" For installation instructions, see: https://github.com/dbeaver/dbeaver/issues/8219

" map leader to spacebar
map <space> <leader>
imap <space><space> <C-O><leader>

" Map ctrl+j, ctrl+k to down/up 10 lines

" Scroll up/down 10 lines at a time shift+j,shift+k
" !important: Must edit native DBeaver key binding for `Incremental Find`
" Preferences > User Interface > Keys
" I changed to Ctrl+F
noremap <C-J> 10j
" !important: Must edit native DBeaver key binding for `Find Next` in
" Preferences > User Interface > Keys
" I changed to Ctrl+N "When `In Windows`"
noremap <C-K> 10k

" Scroll ght/left 10 characters
noremap <C-l> 10l 
noremap <C-h> 10h  

" Remap home and end to "ctrl+;" and ";" in addition to default "1" and "$" 
noremap <leader>a ^
noremap <leader>; $

" Reselect visual block after indent/outdent
vnoremap < <gv
vnoremap > >gv

" Search for visually selected text by pressing // in visual mode
vnoremap // y/<C-R>"<CR>

" Split lines leader+k [This frees up <S-k> for tabnext
noremap <leader>k i<CR><ESC>k

" Join lines on leader+j [This frees up <S-j> for tabprev
noremap <leader>j <S-j>

" Allow pasting from clipboard without autoindenting
set clipboard=autoselectplus

noremap <leader>p "+p

"Overwrites man for word under cursor
map <S-k> :tabnext<CR>
"Overwrites join lines
map <S-j> :tabprev<CR>

"List of eclipseaction commands here: https://github.com/pellaton/eclipse-cheatsheet/blob/master/eclipse4.9/eclipse-shortcuts-win-4.9.pdf
"vrapper documentation on commands:
"http://vrapper.sourceforge.net/documentation/?topic=commandline_commands

"Emulate vim-easymotion using https://github.com/tobiasmelcher/EclipseAceJump
eclipseuiaction aceJumpChar ace.jump.CommandAnyChar
nmap f :aceJumpChar<enter>

eclipseuiaction aceJumpString ace.jump.Command
nmap <S-c> :aceJumpString<enter>

" Tab control from normal/visual mode only (insert mode keeps typing normally).
" eclipseuiaction <name> <command-id> registers an ex-command alias; vrapper runs it
" asynchronously, so the workbench (not vrapper) opens/closes the tab.
eclipseuiaction newTab org.jkiss.dbeaver.core.sql.editor.create
eclipseuiaction closeTab org.eclipse.ui.file.close

noremap <C-t> :newTab<CR>
noremap <S-w> :closeTab<CR>
vnoremap <C-t> <Esc>:newTab<CR>
vnoremap <S-w> <Esc>:closeTab<CR>

" !important for <C-t>: DBeaver binds CTRL+T to "Toggle results panel" in the
" "DBeaver SQL Script" scope, and Eclipse resolves key bindings before Vrapper
" sees the key, so the map above never fires while that binding exists.
" Preferences > User Interface > Keys > select "Toggle results panel" >
" DBeaver scheme / "DBeaver SQL Script" context > Unbind, Apply, restart DBeaver.
" Until then <leader>t (space, t) does the same thing with no preference change.
noremap <leader>t :newTab<CR>
vnoremap <leader>t <Esc>:newTab<CR>

" <S-w> replaces the vim W motion (next WORD) in normal/visual mode;
" keep it reachable on <leader>W.
noremap <leader>W W
vnoremap <leader>W W
